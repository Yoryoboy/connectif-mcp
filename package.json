{
  "name": "connectif-mcp",
  "version": "0.1.0",
  "description": "A minimal Model Context Protocol server for the Connectif HTTP API",
  "type": "module",
  "private": true,
  "author": "Yoryoboy",
  "maintainers": [
    {
      "name": "Yoryoboy"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoryoboy/connectif-mcp.git"
  },
  "homepage": "https://github.com/Yoryoboy/connectif-mcp#readme",
  "bugs": {
    "url": "https://github.com/Yoryoboy/connectif-mcp/issues"
  },
  "keywords": [
    "connectif",
    "mcp",
    "model-context-protocol",
    "api-wrapper",
    "marketing-automation"
  ],
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "bin": {
    "connectif-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "ENDPOINTS.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
